# Large generated artifacts — tracked outside git
data/
models/*
!models/src/
!models/src/**
!models/scripts/
!models/scripts/**
!models/tests/
!models/tests/**
# Re-apply generated-file exclusions after the models source allow-list.
models/**/__pycache__/
models/**/.pytest_cache/
models/**/.ruff_cache/
models/**/*.py[cod]
models/**/._*
solver/reports/
Reference Algorithm/
*.npy
*.npz
**/checkpoints/

# Control console I/O (keep structure via README; ignore run products)
output/by_experiment/**/*
output/by_type/**/*
!output/**/README.md
input/**/*
!input/README.md
!input/**/.gitkeep
.experiment.monitor/

# 仅供阅读学习的第三方仓库（许可证不明，不得提交、不得并入本项目代码）
third_party/study_only/

# Pinned local environment for repository quality gates.
.quality-venv/
.quality-venv-offline-check/
.coop-venv/
