{
  "schema_version": 1,
  "name": "dual-guided-resource-order-engineering",
  "objective": "Verify frozen LP, DP, interfaces and six-worker resources without evaluating candidate objectives",
  "workdir": ".",
  "poll_seconds": 5,
  "stale_seconds": 180,
  "max_runtime_seconds": 180,
  "pause_on_anomaly": true,
  "required_command_substrings": [
    "run_engineering_gate.py"
  ],
  "forbidden_command_substrings": [
    "run_g0.py",
    "exact_china81_score",
    "--tune",
    "--rescue"
  ],
  "min_cpu_percent_when_active": 1,
  "low_cpu_consecutive_checks": 4,
  "max_rss_mb": 4096,
  "min_system_free_memory_mb": 1024,
  "min_system_memory_free_percent": 10,
  "logs": [],
  "progress_files": [],
  "result_files": [
    "engineering_gate_v1/raw_runs.csv",
    "engineering_gate_v1/decision.json"
  ],
  "completion_files": [
    "engineering_gate_v1/done.json"
  ],
  "checkpoint_paths": [],
  "protected_files": [
    {
      "path": "g0_registration_v1.json",
      "kind": "primary_config"
    },
    {
      "path": "../../../docs/handoff/e2_dual_guided_resource_order_contract_20260725.md",
      "kind": "experiment_contract"
    },
    {
      "path": "candidate_core.py",
      "kind": "model"
    },
    {
      "path": "limited_displacement.py",
      "kind": "model"
    },
    {
      "path": "lp_duals.py",
      "kind": "model"
    },
    {
      "path": "run_engineering_gate.py",
      "kind": "evaluator"
    }
  ],
  "csv_rules": [
    {
      "path": "engineering_gate_v1/raw_runs.csv",
      "required": true,
      "required_after_seconds": 150,
      "required_fields": [
        "instance_id",
        "status",
        "candidate_count",
        "dp_states",
        "peak_rss_bytes"
      ],
      "feasible_field": "status",
      "truthy": [
        "PASS"
      ],
      "min_feasible_rate": 1.0,
      "duplicate_key_fields": [
        "instance_id"
      ],
      "max_duplicate_fraction": 0
    }
  ],
  "milestones": [],
  "ai": {
    "enabled": false,
    "timeout_seconds": 180
  }
}

