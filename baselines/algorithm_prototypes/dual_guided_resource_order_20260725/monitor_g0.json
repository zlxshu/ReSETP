{
  "schema_version": 1,
  "name": "dual-guided-resource-order-g0",
  "objective": "Run the single frozen six-instance low-cost falsification gate and independent replay",
  "workdir": ".",
  "poll_seconds": 5,
  "stale_seconds": 180,
  "max_runtime_seconds": 180,
  "pause_on_anomaly": true,
  "required_command_substrings": [
    "run_release_chain.py"
  ],
  "forbidden_command_substrings": [
    "--tune",
    "--rescue",
    "--full"
  ],
  "min_cpu_percent_when_active": 1,
  "low_cpu_consecutive_checks": 4,
  "max_rss_mb": 4096,
  "min_system_free_memory_mb": 1024,
  "min_system_memory_free_percent": 10,
  "logs": [],
  "progress_files": [],
  "result_files": [
    "g0_gate_v1/raw_runs.csv",
    "g0_gate_v1/decision.json"
  ],
  "completion_files": [
    "g0_gate_v1/done.json"
  ],
  "checkpoint_paths": [],
  "protected_files": [
    {
      "path": "g0_registration_v1.json",
      "kind": "primary_config"
    },
    {
      "path": "../../../docs/handoff/e2_dual_guided_resource_order_contract_20260725.md",
      "kind": "experiment_contract"
    },
    {
      "path": "../../../solver/src/setp_solver/check.py",
      "kind": "evaluator"
    },
    {
      "path": "../../../solver/src/setp_solver/china81_completion.py",
      "kind": "evaluator"
    },
    {
      "path": "../../../solver/src/setp_solver/cost.py",
      "kind": "cost_function"
    },
    {
      "path": "../../../solver/src/setp_solver/prices.py",
      "kind": "core_data"
    },
    {
      "path": "candidate_core.py",
      "kind": "model"
    },
    {
      "path": "limited_displacement.py",
      "kind": "model"
    },
    {
      "path": "lp_duals.py",
      "kind": "model"
    },
    {
      "path": "run_g0.py",
      "kind": "model"
    },
    {
      "path": "independent_replay.py",
      "kind": "evaluator"
    }
  ],
  "csv_rules": [
    {
      "path": "g0_gate_v1/raw_runs.csv",
      "required": true,
      "required_after_seconds": 150,
      "required_fields": [
        "instance_id",
        "status",
        "start_objective",
        "output_objective",
        "complete_candidate_evaluations",
        "dp_states",
        "violation_count"
      ],
      "feasible_field": "status",
      "truthy": [
        "OK"
      ],
      "min_feasible_rate": 1.0,
      "violation_field": "violation_count",
      "max_violation_total": 0,
      "duplicate_key_fields": [
        "instance_id"
      ],
      "max_duplicate_fraction": 0
    }
  ],
  "milestones": [],
  "ai": {
    "enabled": false,
    "timeout_seconds": 180
  }
}
