{
  "schema_version": 1,
  "name": "e2-large-pooled-resource-probe",
  "objective": "以两个并行 PR16A HGS 任务测量峰值内存并机械选择正式 workers",
  "workdir": "../../..",
  "poll_seconds": 30,
  "stale_seconds": 1800,
  "max_runtime_seconds": 1800,
  "pause_on_anomaly": true,
  "required_command_substrings": [
    "resource_probe.py"
  ],
  "forbidden_command_substrings": [
    "--smoke",
    "--debug"
  ],
  "min_cpu_percent_when_active": 1,
  "low_cpu_consecutive_checks": 3,
  "max_rss_mb": 3072,
  "min_system_free_memory_mb": 256,
  "min_system_memory_free_percent": 5,
  "logs": [],
  "progress_files": [],
  "result_files": [
    "resource_probe_summary.json",
    "resource_probe_runs/PR16A__s2.json",
    "resource_probe_runs/PR16A__s3.json"
  ],
  "completion_files": [
    "resource_probe_summary.json"
  ],
  "checkpoint_paths": [
    "resource_probe_runs"
  ],
  "protected_files": [
    {
      "path": "TASK_CARD.md",
      "kind": "experiment_contract"
    },
    {
      "path": "../boundary_probe_20260726/d7_long_runs_pooled.py",
      "kind": "algorithm_reference"
    },
    {
      "path": "../../algorithm_foundation/mdvrptw_v13_comparison_20260719/sources/normalised_instances/PR16A.vrp",
      "kind": "core_data"
    },
    {
      "path": "../../algorithm_foundation/mdvrptw_v13_comparison_20260719/sources/current_bks/PR16A.sol",
      "kind": "evaluation_reference"
    },
    {
      "path": "calibration_summary.json",
      "kind": "primary_config"
    }
  ],
  "csv_rules": [],
  "milestones": [],
  "ai": {
    "enabled": false,
    "timeout_seconds": 180
  }
}
