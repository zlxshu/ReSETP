{
  "schema_version": 1,
  "name": "genuine-hybrid-g1-six-worker-resource-probe-v3",
  "objective": "并行执行六个零搜索真实bundle接线任务，只决定后续G1 v6使用6或3 workers",
  "workdir": "../../..",
  "poll_seconds": 15,
  "max_runtime_seconds": 3600,
  "pause_on_anomaly": true,
  "required_command_substrings": [
    "run_g1_six_worker_resource_probe_v3.py"
  ],
  "forbidden_command_substrings": [
    "--smoke",
    "--debug"
  ],
  "min_cpu_percent_when_active": 0,
  "low_cpu_consecutive_checks": 20,
  "max_rss_mb": 7000,
  "min_system_free_memory_mb": 128,
  "min_system_memory_free_percent": 5,
  "logs": [],
  "progress_files": [],
  "result_files": [
    "g1_six_worker_resource_probe_v3/metadata.json",
