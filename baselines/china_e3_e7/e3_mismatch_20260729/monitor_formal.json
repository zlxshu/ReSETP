{
  "schema_version": 1,
  "name": "e3-responsibility-mismatch-formal",
  "objective": "Complete the E3 primary exhibit and multi-depot direction-stability panel",
  "workdir": ".",
  "poll_seconds": 30,
  "stale_seconds": 1200,
  "max_runtime_seconds": 172800,
  "pause_on_anomaly": true,
  "required_command_substrings": ["run_e3_mismatch.py", "formal", "--workers", "4"],
  "forbidden_command_substrings": ["--workers 5"],
  "min_cpu_percent_when_active": 1,
  "low_cpu_consecutive_checks": 5,
  "max_rss_mb": 7500,
  "min_system_memory_free_percent": 5,
  "progress_files": ["progress.json", "raw_runs.csv"],
  "result_files": ["raw_runs.csv", "decision.json", "metadata.json", "artifact_hashes.json", "report.md"],
  "completion_files": ["done.json"],
  "checkpoint_paths": ["tasks"],
  "protected_files": [
    {"path": "pre_registration.json", "kind": "experiment_contract"},
    {"path": "mismatch_assignment.csv", "kind": "core_data"},
    {"path": "run_e3_mismatch.py", "kind": "research_question"},
    {"path": "../../../solver/src/setp_solver/cost.py", "kind": "cost_function"},
    {"path": "../../../solver/src/setp_solver/check.py", "kind": "evaluator"},
    {"path": "../../../solver/src/setp_solver/search/evaluation.py", "kind": "evaluator"},
    {"path": "../../algorithm_prototypes/china81_mechanism_hybrid_20260720/epochal_hgs.py", "kind": "model"},
    {"path": "../../algorithm_prototypes/china81_mechanism_hybrid_20260720/route_pool_sp.py", "kind": "model"}
  ],
  "csv_rules": [
    {
      "path": "raw_runs.csv",
      "required": true,
      "required_after_seconds": 1800,
      "required_fields": ["task_id", "instance_id", "seed", "arm", "status", "violation_count"],
      "feasible_field": "status",
      "truthy": ["PASS"],
      "min_feasible_rate": 1.0,
      "violation_field": "violation_count",
      "max_violation_total": 0,
      "duplicate_key_fields": ["task_id"],
      "max_duplicate_fraction": 0
    }
  ],
  "ai": {"enabled": false, "timeout_seconds": 180}
}
