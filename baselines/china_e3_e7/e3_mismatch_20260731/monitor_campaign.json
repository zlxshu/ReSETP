{
  "schema_version": 1,
  "name": "e3-mismatch-formal-campaign",
  "objective": "Run the preregistered probe, then complete all 180 IND/ZONE/JOINT formal units one instance at a time, independently verify, aggregate, and write done.json last",
  "workdir": ".",
  "poll_seconds": 30,
  "stale_seconds": 7200,
  "max_runtime_seconds": 259200,
  "pause_on_anomaly": true,
  "required_command_substrings": [
    "run_campaign.py",
    "run",
    "--workers",
    "2"
  ],
  "forbidden_command_substrings": [
    "--workers 3",
    "--workers 4",
    "--debug",
    "--smoke"
  ],
  "min_cpu_percent_when_active": 0,
  "cpu_grace_seconds": 300,
  "low_cpu_consecutive_checks": 5,
  "max_rss_mb": 6500,
  "min_system_free_memory_mb": 256,
  "min_system_memory_free_percent": 3,
  "progress_files": [
    "campaign_progress.jsonl",
    "probe_progress.log",
    "formal_progress.log"
  ],
  "result_files": [
    "metadata.json",
    "raw_runs.csv",
    "decision.json",
    "artifact_hashes.json",
    "report.md",
    "done.json"
  ],
  "completion_files": [
    "done.json"
  ],
  "checkpoint_paths": [
    "probe/task_status",
    "probe/search_traces",
    "formal/task_status",
    "formal/search_traces",
    "formal/plans",
    "formal/stages"
  ],
  "protected_files": [
    {
      "path": "run_campaign.py",
      "kind": "experiment_contract"
    },
    {
      "path": "run_e3_mismatch.py",
      "kind": "experiment_contract"
    },
    {
      "path": "check_e3_mismatch.py",
      "kind": "evaluator"
    },
    {
      "path": "source_lock.json",
      "kind": "primary_config"
    },
    {
      "path": "pre_registration.json",
      "kind": "research_question"
    },
    {
      "path": "input_audit/summary.json",
      "kind": "core_data"
    },
    {
      "path": "../../algorithm_prototypes/china81_mechanism_hybrid_20260720/epochal_hgs.py",
      "kind": "search_semantics"
    },
    {
      "path": "../../algorithm_prototypes/china81_mechanism_hybrid_20260720/route_pool_sp.py",
      "kind": "search_semantics"
    },
    {
      "path": "../../../solver/src/setp_solver/cost.py",
      "kind": "cost_function"
    },
    {
      "path": "../../../solver/src/setp_solver/check.py",
      "kind": "evaluator"
    },
    {
      "path": "../../../solver/src/setp_solver/search/evaluation.py",
      "kind": "evaluator"
    },
    {
      "path": "../../../docs/handoff/experiment_contract_v2_journal_aligned_20260730.md",
      "kind": "experiment_contract"
    }
  ],
  "milestones": [
    {
      "path": "campaign_progress.jsonl",
      "min_size": 512
    },
    {
      "path": "formal_progress.log",
      "min_size": 4096
    }
  ],
  "ai": {
    "enabled": false,
    "timeout_seconds": 180
  }
}
