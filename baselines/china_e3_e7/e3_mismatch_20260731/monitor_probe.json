{
  "schema_version": 1,
  "name": "e3-mismatch-convergence-probe",
  "objective": "Complete the preregistered cn-prd-200c-01 JOINT seed-1 convergence probe and atomically lock the common formal evaluation cap",
  "workdir": ".",
  "poll_seconds": 30,
  "stale_seconds": 1200,
  "max_runtime_seconds": 7200,
  "pause_on_anomaly": true,
  "required_command_substrings": [
    "run_e3_mismatch.py",
    "probe",
    "--complete-eval-budget",
    "1500",
    "--workers",
    "1"
  ],
  "forbidden_command_substrings": [
    "--workers 2",
    "--workers 3",
    "--workers 4"
  ],
  "min_cpu_percent_when_active": 1,
  "cpu_grace_seconds": 300,
  "low_cpu_consecutive_checks": 5,
  "max_rss_mb": 6500,
  "min_system_free_memory_mb": 256,
  "min_system_memory_free_percent": 3,
  "progress_files": [
    "probe_progress.log"
  ],
  "result_files": [
    "probe/summary.json",
    "budget_lock.json"
  ],
  "completion_files": [
    "budget_lock.json"
  ],
  "checkpoint_paths": [
    "probe/task_status",
    "probe/search_traces"
  ],
  "protected_files": [
    {
      "path": "source_lock.json",
      "kind": "primary_config"
    },
    {
      "path": "pre_registration.json",
      "kind": "research_question"
    },
    {
      "path": "run_e3_mismatch.py",
      "kind": "experiment_contract"
    },
    {
      "path": "input_audit/summary.json",
      "kind": "core_data"
    },
    {
      "path": "../../algorithm_prototypes/china81_mechanism_hybrid_20260720/epochal_hgs.py",
      "kind": "search_semantics"
    },
    {
      "path": "../../algorithm_prototypes/china81_mechanism_hybrid_20260720/route_pool_sp.py",
      "kind": "search_semantics"
    },
    {
      "path": "../../../solver/src/setp_solver/cost.py",
      "kind": "cost_function"
    },
    {
      "path": "../../../solver/src/setp_solver/check.py",
      "kind": "evaluator"
    },
    {
      "path": "../../../solver/src/setp_solver/search/evaluation.py",
      "kind": "evaluator"
    },
    {
      "path": "../../../docs/handoff/experiment_contract_v2_journal_aligned_20260730.md",
      "kind": "experiment_contract"
    }
  ],
  "milestones": [
    {
      "path": "probe_progress.log",
      "min_size": 128
    }
  ],
  "ai": {
    "enabled": false,
    "timeout_seconds": 180
  }
}
