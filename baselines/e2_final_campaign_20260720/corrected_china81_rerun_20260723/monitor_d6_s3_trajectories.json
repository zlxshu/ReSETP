{
  "schema_version": 1,
  "name": "d6-corrected-s3-trajectories",
  "objective": "按预注册十种子均值最近规则生成修正后仿真算例的四算法观测轨迹",
  "workdir": "../../..",
  "poll_seconds": 20,
  "stale_seconds": 3600,
  "max_runtime_seconds": 7200,
  "pause_on_anomaly": true,
  "required_command_substrings": [
    "run_corrected_s3_trajectories.py"
  ],
  "forbidden_command_substrings": [
    "--smoke",
    "--debug"
  ],
  "min_cpu_percent_when_active": 1,
  "cpu_grace_seconds": 180,
  "low_cpu_consecutive_checks": 5,
  "max_rss_mb": 6000,
  "min_system_free_memory_mb": 256,
  "min_system_memory_free_percent": 5,
  "progress_files": [
    ".d6-corrected-s3-trajectories.monitor/experiment.stdout.log"
  ],
  "result_files": [
    "representative_gate/trajectories/raw_runs.csv",
    "representative_gate/trajectories/decision.json"
  ],
  "completion_files": [
    "representative_gate/trajectories/decision.json"
  ],
  "checkpoint_paths": [
    "representative_gate/trajectories"
  ],
  "protected_files": [
    {
      "path": "run_corrected_s3_trajectories.py",
      "kind": "experiment_contract"
    },
    {
      "path": "run_corrected_s3.py",
      "kind": "experiment_contract"
    },
    {
      "path": "../run_corrected_china81_d6.py",
      "kind": "experiment_contract"
    },
    {
      "path": "../../algorithm_prototypes/china81_mechanism_hybrid_20260720/pyvrp_adapter.py",
      "kind": "model"
    },
    {
      "path": "../../algorithm_prototypes/china81_mechanism_hybrid_20260720/epochal_hgs.py",
      "kind": "model"
    },
    {
      "path": "../../algorithm_prototypes/china81_mechanism_hybrid_20260720/route_pool_sp.py",
      "kind": "model"
    },
    {
      "path": "../../../solver/src/setp_solver/china81.py",
      "kind": "core_data"
    },
    {
      "path": "../../../solver/src/setp_solver/china81_completion.py",
      "kind": "evaluator"
    },
    {
      "path": "../../../solver/src/setp_solver/cost.py",
      "kind": "cost_function"
    },
    {
      "path": "../../../solver/src/setp_solver/check.py",
      "kind": "evaluator"
    },
    {
      "path": "../../../solver/src/setp_solver/prices.py",
      "kind": "model"
    }
  ],
  "milestones": [
    {
      "path": "representative_gate/trajectories",
      "min_size": 1
    }
  ],
  "ai": {
    "enabled": false,
    "timeout_seconds": 180
  }
}
