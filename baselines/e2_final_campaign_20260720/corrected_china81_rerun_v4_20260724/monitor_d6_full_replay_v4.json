{
  "schema_version": 1,
  "name": "d6-corrected-full-witness-replay-v4",
  "objective": "不重新搜索，独立复算405个任务保存的1620个方案及其时间地域价格碳参数",
  "workdir": "../../..",
  "poll_seconds": 20,
  "stale_seconds": 900,
  "max_runtime_seconds": 7200,
  "pause_on_anomaly": true,
  "required_command_substrings": [
    "replay_corrected_d6_witnesses.py"
  ],
  "forbidden_command_substrings": [
    "--smoke",
    "--debug"
  ],
  "min_cpu_percent_when_active": 0.2,
  "cpu_grace_seconds": 120,
  "low_cpu_consecutive_checks": 5,
  "max_rss_mb": 10000,
  "min_system_memory_free_percent": 5,
  "progress_files": [
    ".d6-corrected-full-witness-replay-v4.monitor/experiment.stdout.log"
  ],
  "result_files": [
    "full_witness_replay/raw_runs.csv",
    "full_witness_replay/decision.json"
  ],
  "completion_files": [
    "full_witness_replay/done.json"
  ],
  "checkpoint_paths": [
    "full_witness_replay/input_manifests"
  ],
  "protected_files": [
    {
      "path": "full_gate/raw_runs.csv",
      "kind": "core_data"
    },
    {
      "path": "full_gate/decision.json",
      "kind": "experiment_contract"
    },
    {
      "path": "full_witness_replay_preregistration.json",
      "kind": "primary_config"
    },
    {
      "path": "../corrected_china81_rerun_20260723/replay_corrected_d6_witnesses.py",
      "kind": "experiment_contract"
    },
    {
      "path": "../../china_e3_e7/release_v6_config.py",
      "kind": "experiment_contract"
    },
    {
      "path": "../../china_e3_e7/formal_e3_runner.py",
      "kind": "experiment_contract"
    },
    {
      "path": "../../../solver/src/setp_solver/china81.py",
      "kind": "core_data"
    },
    {
      "path": "../../../solver/src/setp_solver/china81_completion.py",
      "kind": "evaluator"
    },
    {
      "path": "../../../solver/src/setp_solver/cost.py",
      "kind": "cost_function"
    },
    {
      "path": "../../../solver/src/setp_solver/check.py",
      "kind": "evaluator"
    },
    {
      "path": "../../../solver/src/setp_solver/prices.py",
      "kind": "model"
    }
  ],
  "ai": {
    "enabled": false,
    "timeout_seconds": 180
  }
}
