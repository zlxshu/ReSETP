{
  "schema_version": 1,
  "name": "d6-corrected-s3-representative-v4",
  "objective": "按输入特征规则登记50客户仿真算例，补齐种子6至10并为最佳路径明细提供十次结果",
  "workdir": "../../..",
  "poll_seconds": 20,
  "stale_seconds": 1800,
  "max_runtime_seconds": 14400,
  "pause_on_anomaly": true,
  "required_command_substrings": [
    "run_corrected_s3.py",
    "--workers",
    "5"
  ],
  "forbidden_command_substrings": [
    "--register-only",
    "--finalize-only",
    "--smoke",
    "--debug"
  ],
  "min_cpu_percent_when_active": 1,
  "cpu_grace_seconds": 180,
  "low_cpu_consecutive_checks": 4,
  "max_rss_mb": 12000,
  "min_system_memory_free_percent": 5,
  "progress_files": [
    ".d6-corrected-s3-representative-v4.monitor/experiment.stdout.log"
  ],
  "result_files": [
    "representative_gate/raw_runs.csv",
