{
  "schema_version": 1,
  "name": "e2-staged-v5-s3-genuine-trajectory",
  "objective": "补跑预登记仿真算例的种子6至10并验收四种算法是否形成真实且清晰的迭代下降曲线",
  "workdir": "../../..",
  "poll_seconds": 20,
  "stale_seconds": 2700,
  "max_runtime_seconds": 21600,
  "pause_on_anomaly": true,
  "required_command_substrings": [
    "run_e2_staged_s3_trajectory_gate.py",
    "--workers",
    "3"
  ],
  "forbidden_command_substrings": [
    "--finalize-only",
    "--smoke",
    "--debug"
  ],
  "min_cpu_percent_when_active": 1,
  "low_cpu_consecutive_checks": 8,
  "max_rss_mb": 7600,
  "min_system_free_memory_mb": 256,
  "min_system_memory_free_percent": 5,
  "logs": [],
  "progress_files": [],
  "result_files": [
    "s3_trajectory_gate/raw_runs.csv",
    "s3_trajectory_gate/curve_data.csv",
    "s3_trajectory_gate/decision.json",
    "s3_trajectory_gate/artifact_hashes.json"
  ],
  "completion_files": [
    "s3_trajectory_gate/done.json"
  ],
