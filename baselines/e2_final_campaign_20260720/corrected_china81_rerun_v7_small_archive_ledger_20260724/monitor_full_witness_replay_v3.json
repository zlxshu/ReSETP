{
  "schema_version": 1,
  "name": "d6-e2-staged-v7-full-witness-replay",
  "objective": "独立重算修正版E2的1620个封存方案，核对可行性、成本、排放、日期地域价格、有限车队、预算和历史档案账本",
  "workdir": "../../..",
  "poll_seconds": 15,
  "stale_seconds": 1800,
  "max_runtime_seconds": 14400,
  "pause_on_anomaly": true,
  "required_command_substrings": [
    "replay_corrected_d6_staged_witnesses.py"
  ],
  "forbidden_command_substrings": [
    "run_corrected_china81_d6_staged_portfolio.py",
    "--smoke",
    "--debug"
  ],
  "min_cpu_percent_when_active": 1,
  "low_cpu_consecutive_checks": 8,
  "max_rss_mb": 5000,
  "min_system_free_memory_mb": 128,
  "min_system_memory_free_percent": 3,
  "logs": [],
  "progress_files": [],
  "result_files": [
    "full_witness_replay/raw_runs.csv",
    "full_witness_replay/decision.json",
    "full_witness_replay/artifact_hashes.json"
  ],
  "completion_files": [
    "full_witness_replay/done.json"
  ],
  "checkpoint_paths": [
    "full_witness_replay/input_manifests"
  ],
  "protected_files": [
    {
      "path": "full_witness_replay_preregistration_v3.json",
      "kind": "experiment_contract"
    },
    {
      "path": "formal_preregistration_v4.json",
      "kind": "experiment_contract"
    },
    {
      "path": "full_gate/raw_runs.csv",
      "kind": "core_data"
    },
    {
      "path": "full_gate/decision.json",
      "kind": "experiment_decision"
    },
    {
      "path": "full_gate/artifact_hashes.json",
      "kind": "artifact_manifest"
    },
    {
      "path": "../replay_corrected_d6_staged_witnesses.py",
      "kind": "validation_runner"
    },
    {
      "path": "../../china_e3_e7/formal_e3_runner.py",
      "kind": "validation_dependency"
    },
    {
      "path": "../../../solver/src/setp_solver/cost.py",
      "kind": "cost_function"
    },
    {
      "path": "../../../solver/src/setp_solver/check.py",
      "kind": "evaluator"
    },
    {
      "path": "../../../solver/src/setp_solver/china81_completion.py",
      "kind": "evaluator"
    },
    {
      "path": "../../../docs/paper_v2/paper_main.tex",
      "kind": "paper_conclusion"
    }
  ],
  "milestones": [],
  "ai": {
    "enabled": false,
    "timeout_seconds": 180
  }
}
