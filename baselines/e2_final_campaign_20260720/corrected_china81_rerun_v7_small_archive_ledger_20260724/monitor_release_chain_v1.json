{
  "schema_version": 1,
  "name": "e2-staged-v7-release-chain",
  "objective": "正式E2通过后按冻结顺序自动执行1620解复算、结果强度门、真实迭代数据、路线明细和零搜索表图生成，任一步失败即停止",
  "workdir": "../../..",
  "poll_seconds": 30,
  "stale_seconds": 300,
  "max_runtime_seconds": 259200,
  "pause_on_anomaly": true,
  "required_command_substrings": [
    "run_e2_staged_release_chain.py"
  ],
  "forbidden_command_substrings": [
    "--smoke",
    "--debug"
  ],
  "min_cpu_percent_when_active": 0,
  "low_cpu_consecutive_checks": 20,
  "max_rss_mb": 9000,
  "min_system_free_memory_mb": 128,
  "min_system_memory_free_percent": 3,
  "logs": [],
  "progress_files": [
    "release_chain/progress.json"
  ],
  "result_files": [
    "release_chain/decision.json",
    "release_chain/artifact_hashes.json"
  ],
  "completion_files": [
    "release_chain/done.json"
  ],
  "checkpoint_paths": [
    "full_gate/tasks",
    "full_witness_replay",
    "s3_trajectory_gate/extra_seed_tasks/tasks"
  ],
  "protected_files": [
    {
      "path": "release_chain_registration_v1.json",
      "kind": "release_contract"
    },
    {
      "path": "formal_preregistration_v4.json",
      "kind": "experiment_contract"
    },
    {
      "path": "full_witness_replay_preregistration_v3.json",
      "kind": "validation_contract"
    },
    {
      "path": "result_strength_audit_preregistration_v3.json",
      "kind": "analysis_contract"
    },
    {
      "path": "s3_trajectory_case_registration_v2.json",
      "kind": "experiment_contract"
    },
    {
      "path": "s3_trajectory_execution_preregistration_v2.json",
      "kind": "experiment_contract"
    },
    {
      "path": "s4_route_detail_preregistration_v3.json",
      "kind": "validation_contract"
    },
    {
      "path": "s5_artifact_protocol_preregistration_v1.json",
      "kind": "presentation_contract"
    },
    {
      "path": "s5_artifact_runner_registration_v1.json",
      "kind": "presentation_contract"
    },
    {
      "path": "monitor_full_witness_replay_v3.json",
      "kind": "monitor_contract"
    },
    {
      "path": "monitor_result_strength_v3.json",
      "kind": "monitor_contract"
    },
    {
      "path": "monitor_s3_trajectory_v2.json",
      "kind": "monitor_contract"
    },
    {
      "path": "monitor_s4_route_detail_v3.json",
      "kind": "monitor_contract"
    },
    {
      "path": "monitor_s5_artifacts_v1.json",
      "kind": "monitor_contract"
    },
    {
      "path": "../run_e2_staged_release_chain.py",
      "kind": "release_runner"
    },
    {
      "path": "../../../docs/paper_v2/paper_main.tex",
      "kind": "paper_conclusion"
    }
  ],
  "milestones": [],
  "ai": {
    "enabled": false,
    "timeout_seconds": 180
  }
}
