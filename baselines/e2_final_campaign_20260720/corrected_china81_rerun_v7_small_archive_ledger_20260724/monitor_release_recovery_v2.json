{
  "schema_version": 1,
  "name": "e2-staged-v7-release-recovery-v2",
  "objective": "验证已封存的正式E2与1620解复算PASS后，从结果强度门继续冻结的S3-S5发布阶段，不重跑已完成上游",
  "workdir": "../../..",
  "poll_seconds": 30,
  "max_runtime_seconds": 172800,
  "pause_on_anomaly": true,
  "required_command_substrings": [
    "run_e2_staged_release_recovery_v2.py",
    "--execute"
  ],
  "forbidden_command_substrings": [
    "--smoke",
    "--debug"
  ],
  "min_cpu_percent_when_active": 0,
  "low_cpu_consecutive_checks": 20,
  "max_rss_mb": 9000,
  "min_system_free_memory_mb": 128,
  "min_system_memory_free_percent": 5,
  "logs": [
    "release_recovery_v2/result_strength.log",
    "release_recovery_v2/s3_trajectory.log",
    "release_recovery_v2/s4_route_detail.log",
    "release_recovery_v2/s5_artifacts.log"
  ],
  "progress_files": [],
  "result_files": [
    "release_recovery_v2/metadata.json",
    "release_recovery_v2/raw_runs.csv",
    "release_recovery_v2/decision.json",
    "release_recovery_v2/artifact_hashes.json",
    "release_recovery_v2/report.md"
  ],
  "completion_files": [
    "release_recovery_v2/done.json"
  ],
  "checkpoint_paths": [
    "full_gate/tasks",
    "full_witness_replay",
    "s3_trajectory_gate/extra_seed_tasks/tasks"
  ],
  "protected_files": [
    {
      "path": "release_recovery_registration_v2.json",
      "kind": "experiment_contract"
    },
    {
      "path": "../run_e2_staged_release_recovery_v2.py",
      "kind": "release_runner"
    },
    {
      "path": "formal_preregistration_v4.json",
      "kind": "experiment_contract"
    },
    {
      "path": "full_witness_replay_preregistration_v3.json",
      "kind": "validation_contract"
    },
    {
      "path": "result_strength_audit_preregistration_v3.json",
      "kind": "analysis_contract"
    },
    {
      "path": "s3_trajectory_execution_preregistration_v2.json",
      "kind": "experiment_contract"
    },
    {
      "path": "s4_route_detail_preregistration_v3.json",
      "kind": "validation_contract"
    },
    {
      "path": "s5_artifact_runner_registration_v1.json",
      "kind": "presentation_contract"
    },
    {
      "path": "../run_e2_staged_result_strength_audit.py",
      "kind": "analysis_runner"
    },
    {
      "path": "../run_e2_staged_s3_trajectory_gate.py",
      "kind": "experiment_runner"
    },
    {
      "path": "../run_e2_staged_s4_route_detail_v3.py",
      "kind": "validation_runner"
    },
    {
      "path": "../run_e2_staged_s5_artifacts.py",
      "kind": "presentation_runner"
    },
    {
      "path": "../../../solver/src/setp_solver/cost.py",
      "kind": "cost_function"
    },
    {
      "path": "../../../solver/src/setp_solver/check.py",
      "kind": "evaluator"
    },
    {
      "path": "../../../solver/src/setp_solver/search/evaluation.py",
      "kind": "evaluator"
    },
    {
      "path": "../../../solver/src/setp_solver/prices.py",
      "kind": "core_data"
    },
    {
      "path": "../../../docs/paper_v2/paper_main.tex",
      "kind": "paper_conclusion"
    }
  ],
  "ai": {
    "enabled": false,
    "timeout_seconds": 180
  }
}
