{
  "schema_version": 1,
  "name": "e2-staged-v7-result-strength-audit",
  "objective": "按结果出来前冻结的门槛审查修正版E2是否足以写入论文并放行后续实验",
  "workdir": "../../..",
  "poll_seconds": 5,
  "stale_seconds": 300,
  "max_runtime_seconds": 1800,
  "pause_on_anomaly": true,
  "required_command_substrings": [
    "run_e2_staged_result_strength_audit.py"
  ],
  "forbidden_command_substrings": [
    "--smoke",
    "--debug"
  ],
  "min_cpu_percent_when_active": 0,
  "low_cpu_consecutive_checks": 20,
  "max_rss_mb": 3000,
  "min_system_free_memory_mb": 128,
  "min_system_memory_free_percent": 3,
  "logs": [],
  "progress_files": [],
  "result_files": [
    "result_strength_gate/result_summary.json",
    "result_strength_gate/decision.json",
    "result_strength_gate/artifact_hashes.json"
  ],
  "completion_files": [
    "result_strength_gate/done.json"
  ],
  "checkpoint_paths": [],
  "protected_files": [
    {
      "path": "formal_preregistration_v4.json",
      "kind": "experiment_contract"
    },
    {
      "path": "result_strength_audit_preregistration_v3.json",
      "kind": "analysis_contract"
    },
    {
      "path": "full_gate/raw_runs.csv",
      "kind": "core_data"
    },
    {
      "path": "full_gate/artifact_hashes.json",
      "kind": "artifact_manifest"
    },
    {
      "path": "full_witness_replay/raw_runs.csv",
      "kind": "validation_data"
    },
    {
      "path": "full_witness_replay/artifact_hashes.json",
      "kind": "artifact_manifest"
    },
    {
      "path": "../run_e2_staged_result_strength_audit.py",
      "kind": "analysis_runner"
    },
    {
      "path": "../../../docs/paper_v2/paper_main.tex",
      "kind": "paper_conclusion"
    }
  ],
  "milestones": [],
  "ai": {
    "enabled": false,
    "timeout_seconds": 180
  }
}
