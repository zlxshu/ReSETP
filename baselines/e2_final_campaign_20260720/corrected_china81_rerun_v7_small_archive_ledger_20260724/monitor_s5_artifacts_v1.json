{
  "schema_version": 1,
  "name": "e2-staged-v7-s5-artifacts",
  "objective": "从全部通过的封存证据零搜索生成E2正文表格和图3、图4，并核对数据、端点、坐标和出版社格式",
  "workdir": "../../..",
  "poll_seconds": 5,
  "stale_seconds": 300,
  "max_runtime_seconds": 1800,
  "pause_on_anomaly": true,
  "required_command_substrings": [
    "run_e2_staged_s5_artifacts.py"
  ],
  "forbidden_command_substrings": [
    "--smoke",
    "--debug"
  ],
  "min_cpu_percent_when_active": 0,
  "low_cpu_consecutive_checks": 20,
  "max_rss_mb": 3000,
  "min_system_free_memory_mb": 128,
  "min_system_memory_free_percent": 3,
  "logs": [],
  "progress_files": [],
  "result_files": [
    "artifacts/decision.json",
    "artifacts/artifact_hashes.json",
    "artifacts/figure3_carbon_profile.pdf",
    "artifacts/figure4_iteration.pdf"
  ],
  "completion_files": [
    "artifacts/done.json"
  ],
  "checkpoint_paths": [],
  "protected_files": [
    {
      "path": "s5_artifact_protocol_preregistration_v1.json",
      "kind": "presentation_contract"
    },
    {
      "path": "s5_artifact_runner_registration_v1.json",
      "kind": "presentation_contract"
    },
    {
      "path": "../run_e2_staged_s5_artifacts.py",
      "kind": "presentation_runner"
    },
    {
      "path": "full_gate/artifact_hashes.json",
      "kind": "formal_manifest"
    },
    {
      "path": "full_witness_replay/artifact_hashes.json",
      "kind": "replay_manifest"
    },
    {
      "path": "result_strength_gate/artifact_hashes.json",
      "kind": "analysis_manifest"
    },
    {
      "path": "s3_trajectory_gate/artifact_hashes.json",
      "kind": "trajectory_manifest"
    },
    {
      "path": "table4_gate/artifact_hashes.json",
      "kind": "route_detail_manifest"
    },
    {
      "path": "../../../docs/paper_v2/setp-new.cls",
      "kind": "publisher_format"
    },
    {
      "path": "../../../docs/paper_v2/paper_main.tex",
      "kind": "paper_conclusion"
    }
  ],
  "milestones": [],
  "ai": {
    "enabled": false,
    "timeout_seconds": 180
  }
}
