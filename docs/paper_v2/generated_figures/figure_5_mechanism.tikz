% 图：两个价格信号错位下企业充电决策的形成机理（4.4.2，2026-09-06 概念版第二稿）
% 皮囊：王强, 王哲璇, 刘玉奇. 管理科学学报, 2023, 26(11): 58–80, 图 5（三层×阶段网格，竖箭头，阶段虚线框，左侧竖排层名）。
% 用户令：不放数字、小白能懂 → 每框最多两行、每行 ≤11 字；层名缩为四字以免竖排相撞；同层框等高。
\begin{tikzpicture}[
  every node/.style={font=\scriptsize},
  box/.style={draw, line width=0.4pt, rectangle, text width=3.0cm, align=center, inner xsep=3pt, inner ysep=3pt, minimum height=0.85cm, fill=white},
  tier/.style={font=\scriptsize, rotate=90, anchor=center},
  arr/.style={-{Stealth[length=4pt]}, line width=0.4pt},
  frame/.style={draw, dashed, line width=0.4pt, inner xsep=4pt, inner ysep=6pt},
  stage/.style={font=\scriptsize, anchor=north, yshift=-2pt}
]
\def\dx{4.15}
\def\ymid{1.60}
\def\ytop{3.20}
% ---- 列 1 首趟出车前
\node[box] (c1b) at (0,0)      {谷段电价时段碳强度最高\\低碳时段电价较高};
\node[box] (c1m) at (0,\ymid)  {降低电费与减少排放相互牵制\\碳价过低，充电随电价安排};
\node[box] (c1t) at (0,\ytop)  {补电移入夜间谷段\\电费降低，排放增加};
% ---- 列 2 午休
\node[box] (c2b) at (\dx,0)      {午后电价与碳强度同时较低};
\node[box] (c2m) at (\dx,\ymid)  {降费与减排方向一致\\受下午班开工时刻限制};
\node[box] (c2t) at (\dx,\ytop)  {补电靠近午后\\减排幅度有限};
% ---- 列 3 趟间
\node[box] (c3b) at (2*\dx,0)      {电价与碳强度变化平缓};
\node[box] (c3m) at (2*\dx,\ymid)  {回场后即发车\\受客户时间窗限制};
\node[box] (c3t) at (2*\dx,\ytop)  {充电时刻不变};
% ---- 列 4 全日
\node[box] (c4b) at (3*\dx,0)      {碳价较低且未覆盖道路物流\\排放以燃油车直接排放为主};
\node[box] (c4m) at (3*\dx,\ymid)  {车队与路线\\按含碳总成本择优};
\node[box] (c4t) at (3*\dx,\ytop)  {总成本低于即充\\总排放与之接近};
% ---- 竖箭头与标注
\foreach \i in {1,2,3,4}{
  \draw[arr] (c\i b.north) -- node[right, inner sep=1.5pt]{约束} (c\i m.south);
  \draw[arr] (c\i m.north) -- node[right, inner sep=1.5pt]{导致} (c\i t.south);
}
% ---- 阶段虚线框与阶段名
\foreach \i/\lab in {1/首趟出车前, 2/午休, 3/趟间, 4/全日}{
  \node[frame, fit=(c\i b) (c\i t)] (f\i) {};
  \node[stage] at (f\i.south) {\lab};
}
% ---- 层名（四字，竖排不相撞）
\node[tier] at (-2.05,0)      {外部条件};
\node[tier] at (-2.05,\ymid)  {企业决策};
\node[tier] at (-2.05,\ytop)  {充电结果};
\end{tikzpicture}
