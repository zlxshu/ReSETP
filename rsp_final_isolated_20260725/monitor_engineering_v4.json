{
  "schema_version": 1,
  "name": "resource-slot-pricing-engineering-isolated-v4",
  "objective": "Verify exact runner identity in six spawned workers, then run unchanged zero-objective engineering and resource gates",
  "workdir": "..",
  "poll_seconds": 5,
  "stale_seconds": 120,
  "max_runtime_seconds": 210,
  "pause_on_anomaly": true,
  "required_command_substrings": ["rsp_final_isolated_20260725.engineering"],
  "forbidden_command_substrings": ["rsp_final_isolated_20260725.g0", "exact_china81_score", "--tune", "--rescue"],
  "min_cpu_percent_when_active": 1,
  "low_cpu_consecutive_checks": 4,
  "max_rss_mb": 4096,
  "min_system_free_memory_mb": 1024,
  "min_system_memory_free_percent": 10,
  "logs": [],
  "progress_files": [],
  "result_files": ["rsp_final_isolated_20260725/engineering_gate_v4/raw_runs.csv", "rsp_final_isolated_20260725/engineering_gate_v4/decision.json"],
  "completion_files": ["rsp_final_isolated_20260725/engineering_gate_v4/done.json"],
  "checkpoint_paths": [],
  "protected_files": [
    {"path": "rsp_final_isolated_20260725/g0_registration_v4.json", "kind": "primary_config"},
    {"path": "docs/handoff/e2_resource_slot_pricing_candidate_review_20260725.md", "kind": "experiment_contract"},
    {"path": "docs/handoff/e2_resource_slot_pricing_isolated_final_v4_20260725.md", "kind": "experiment_contract"},
    {"path": "rsp_final_isolated_20260725/frozen_loader.py", "kind": "model"},
    {"path": "rsp_final_isolated_20260725/workers.py", "kind": "model"},
    {"path": "rsp_final_isolated_20260725/engineering.py", "kind": "evaluator"}
  ],
  "csv_rules": [
    {
      "path": "rsp_final_isolated_20260725/engineering_gate_v4/raw_runs.csv",
      "required": true,
      "required_after_seconds": 180,
      "required_fields": ["task_id", "instance_id", "lane", "status", "extensions", "complete_labels", "peak_rss_bytes", "runner_module", "runner_file"],
      "feasible_field": "status",
      "truthy": ["PASS"],
      "min_feasible_rate": 1.0,
      "duplicate_key_fields": ["task_id"],
      "max_duplicate_fraction": 0
    }
  ],
  "milestones": [],
  "ai": {"enabled": false, "timeout_seconds": 210}
}

