{
  "schema_version": 1,
  "name": "resource-slot-pricing-g0-isolated-v4",
  "objective": "Run and independently replay the unchanged frozen six-task G0 through exact-identity isolated workers",
  "workdir": "..",
  "poll_seconds": 5,
  "stale_seconds": 180,
  "max_runtime_seconds": 300,
  "pause_on_anomaly": true,
  "required_command_substrings": ["rsp_final_isolated_20260725.release"],
  "forbidden_command_substrings": ["--tune", "--rescue", "--full"],
  "min_cpu_percent_when_active": 1,
  "low_cpu_consecutive_checks": 4,
  "max_rss_mb": 4096,
  "min_system_free_memory_mb": 1024,
  "min_system_memory_free_percent": 10,
  "logs": [],
  "progress_files": [],
  "result_files": ["rsp_final_isolated_20260725/g0_gate_v4/raw_runs.csv", "rsp_final_isolated_20260725/g0_gate_v4/decision.json"],
  "completion_files": ["rsp_final_isolated_20260725/g0_gate_v4/done.json"],
  "checkpoint_paths": [],
  "protected_files": [
    {"path": "rsp_final_isolated_20260725/g0_registration_v4.json", "kind": "primary_config"},
    {"path": "docs/handoff/e2_resource_slot_pricing_candidate_review_20260725.md", "kind": "experiment_contract"},
    {"path": "docs/handoff/e2_resource_slot_pricing_isolated_final_v4_20260725.md", "kind": "experiment_contract"},
    {"path": "solver/src/setp_solver/check.py", "kind": "evaluator"},
    {"path": "solver/src/setp_solver/china81_completion.py", "kind": "evaluator"},
    {"path": "solver/src/setp_solver/cost.py", "kind": "cost_function"},
    {"path": "solver/src/setp_solver/prices.py", "kind": "core_data"},
    {"path": "rsp_final_isolated_20260725/frozen_loader.py", "kind": "model"},
    {"path": "rsp_final_isolated_20260725/workers.py", "kind": "model"},
    {"path": "rsp_final_isolated_20260725/g0.py", "kind": "model"},
    {"path": "rsp_final_isolated_20260725/replay.py", "kind": "evaluator"}
  ],
  "csv_rules": [
    {
      "path": "rsp_final_isolated_20260725/g0_gate_v4/raw_runs.csv",
      "required": true,
      "required_after_seconds": 240,
      "required_fields": ["task_id", "instance_id", "lane", "status", "start_objective", "output_objective", "complete_candidate_evaluations", "label_extensions", "violation_count", "runner_module", "runner_file"],
      "feasible_field": "status",
      "truthy": ["OK"],
      "min_feasible_rate": 1.0,
      "violation_field": "violation_count",
      "max_violation_total": 0,
      "duplicate_key_fields": ["task_id"],
      "max_duplicate_fraction": 0
    }
  ],
  "milestones": [],
  "ai": {"enabled": false, "timeout_seconds": 300}
}

